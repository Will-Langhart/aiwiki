# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (service role — this is a trusted backend, never ship to client) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Optional: GitHub token for higher rate limits when reading real star counts ---
GITHUB_TOKEN=

# --- Optional: LangSmith tracing (dogfooding — we list LangSmith in the directory) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=aiwiki-enrichment

# --- Cost guardrail (mirrors CLAUDE.md: every LLM call is capped) ---
ENRICH_DAILY_COST_CAP_USD=5.0

# --- Model routing (override per node; defaults chosen for accuracy) ---
MODEL_EXTRACT=claude-sonnet-4-6
MODEL_CATEGORIZE=claude-haiku-4-5-20251001
MODEL_VERIFY=claude-sonnet-4-6
MODEL_WRITE=claude-sonnet-4-6
MODEL_CRITIQUE=claude-haiku-4-5-20251001
